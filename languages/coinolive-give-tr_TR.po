msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: tr_TR\n"
"X-Domain: coinolive-give\n"

msgid "Coino Live Crypto Donations needs GiveWP 3 or newer to be installed and active."
msgstr "Coino Live Kripto Bağışları için GiveWP 3 veya üstü kurulu ve etkin olmalıdır."

msgid "Settings"
msgstr "Ayarlar"

msgid "Dashboard"
msgstr "Pano"

msgid "Every five minutes"
msgstr "Beş dakikada bir"

msgid "Coino Live"
msgstr "Coino Live"

msgid "Sorry, you are not allowed to access this page."
msgstr "Bu sayfaya erişim izniniz yok."

msgid "Open Coino Live dashboard"
msgstr "Coino Live panosunu aç"

msgid "Add your Coino Live API key to see your balance and payments here."
msgstr "Bakiyenizi ve ödemelerinizi burada görmek için Coino Live API anahtarınızı ekleyin."

msgid "Balance"
msgstr "Bakiye"

msgid "Total"
msgstr "Toplam"

msgid "Withdraw"
msgstr "Para çek"

msgid "Your whole Coino Live account (all gateways), after fees. Withdraw from the Coino Live dashboard."
msgstr "Tüm Coino Live hesabınız (tüm ağ geçitleri), ücretler düşüldükten sonra. Para çekme işlemi Coino Live panosundan yapılır."

msgid "No balance yet. Paid donations are added here after fees."
msgstr "Henüz bakiye yok. Ödenen bağışlar ücretler düşüldükten sonra buraya eklenir."

msgid "Payments"
msgstr "Ödemeler"

msgid "All"
msgstr "Tümü"

msgid "Donation number"
msgstr "Bağış numarası"

msgid "Search"
msgstr "Ara"

msgid "Date"
msgstr "Tarih"

msgid "Order"
msgstr "Sipariş"

msgid "Status"
msgstr "Durum"

msgid "Amount"
msgstr "Tutar"

msgid "Received"
msgstr "Alınan"

msgid "Transactions"
msgstr "İşlemler"

msgid "No payments found."
msgstr "Ödeme bulunamadı."

msgid "Newer"
msgstr "Daha yeni"

msgid "Older"
msgstr "Daha eski"

msgid "%s USD missing"
msgstr "%s USD eksik"

msgid "Payment page"
msgstr "Ödeme sayfası"

msgid "Paid"
msgstr "Ödendi"

msgid "Partially paid"
msgstr "Kısmen ödendi"

msgid "Confirming"
msgstr "Onaylanıyor"

msgid "Waiting for payment"
msgstr "Ödeme bekleniyor"

msgid "Expired"
msgstr "Süresi doldu"

msgid "Cancelled"
msgstr "İptal edildi"

msgid "Could not load from Coino Live: %s"
msgstr "Coino Live'dan yüklenemedi: %s"

msgid "The Coino Live API key is not set."
msgstr "Coino Live API anahtarı girilmemiş."

msgid "Could not reach Coino Live: %s"
msgstr "Coino Live'a ulaşılamadı: %s"

msgid "There is no Coino Live API at %1$s (HTTP %2$d). Check the API URL setting."
msgstr "%1$s adresinde Coino Live API bulunamadı (HTTP %2$d). API URL ayarını kontrol edin."

msgid "Unexpected answer from Coino Live."
msgstr "Coino Live'dan beklenmeyen yanıt."

msgid "Coino Live (crypto)"
msgstr "Coino Live (kripto)"

msgid "Donate with crypto"
msgstr "Kripto ile bağış yap"

msgid "Donate with USDT, Bitcoin, Ethereum, TRON, TON, Solana and more. You will be taken to a secure payment page."
msgstr "USDT, Bitcoin, Ethereum, TRON, TON, Solana ve daha fazlasıyla bağış yapın. Güvenli bir ödeme sayfasına yönlendirileceksiniz."

msgid "Crypto donations are not set up yet. Please choose another payment method."
msgstr "Kripto bağışlar henüz ayarlanmadı. Lütfen başka bir ödeme yöntemi seçin."

msgid "Crypto donations are not available right now: %s"
msgstr "Kripto bağışlar şu anda kullanılamıyor: %s"

msgid "Crypto donations are refunded from the Coino Live dashboard."
msgstr "Kripto bağışların iadesi Coino Live panosundan yapılır."

msgid "Donation #%1$s to %2$s"
msgstr "%2$s için bağış #%1$s"

msgid "Coino Live returned a payment that does not belong to this donation. Please try again."
msgstr "Coino Live bu bağışa ait olmayan bir ödeme döndürdü. Lütfen tekrar deneyin."

msgid "Coino Live payment %1$s created (%2$s USD). Waiting for the donor to pay."
msgstr "Coino Live ödemesi %1$s oluşturuldu (%2$s USD). Bağışçının ödemesi bekleniyor."

msgid "Another Coino Live payment (%1$s) was paid for this donation: %2$s."
msgstr "Bu bağış için başka bir Coino Live ödemesi (%1$s) yapıldı: %2$s."

msgid "Coino Live payment is paid but was for %1$s, the donation is %2$s. Please check."
msgstr "Coino Live ödemesi yapıldı ancak tutarı %1$s idi, bağış %2$s. Lütfen kontrol edin."

msgid "Coino Live payment %1$s confirmed: %2$s"
msgstr "Coino Live ödemesi %1$s onaylandı: %2$s"

msgid "Coino Live: the payment was sent and is waiting for network confirmations."
msgstr "Coino Live: ödeme gönderildi, ağ onayları bekleniyor."

msgid "Coino Live: only %1$s of %2$s USD received so far. The donor was asked to send the rest."
msgstr "Coino Live: şu ana kadar %2$s USD tutarın yalnızca %1$s USD kısmı alındı. Bağışçıdan kalanını göndermesi istendi."

msgid "Coino Live: the payment closed with %1$s of %2$s USD received (in your Coino Live balance)."
msgstr "Coino Live: ödeme %2$s USD tutarın %1$s USD kısmı alınarak kapandı (Coino Live bakiyenizde)."

msgid "Coino Live: the payment window closed without payment."
msgstr "Coino Live: ödeme süresi ödeme yapılmadan doldu."

msgid "API key"
msgstr "API anahtarı"

msgid "Create one in your Coino Live dashboard under Developers. Keys start with ck_live_ (or ck_test_ on the test network)."
msgstr "Coino Live panelinizde Geliştiriciler bölümünden oluşturun. Anahtarlar ck_live_ (test ağında ck_test_) ile başlar."

msgid "Webhook signing secret (optional)"
msgstr "Webhook imza anahtarı (isteğe bağlı)"

msgid "From your gateway settings (whsec_…). When set, webhooks with a wrong signature are refused. Donations are always checked against the API before they change, so this is an extra layer."
msgstr "Ağ geçidi ayarlarınızdan (whsec_…). Girildiğinde, imzası hatalı webhook'lar reddedilir. Bağışlar değişmeden önce her zaman API üzerinden kontrol edilir; bu ek bir güvenlik katmanıdır."

msgid "Payment window (minutes)"
msgstr "Ödeme süresi (dakika)"

msgid "How long the donor has to send the payment. Between 15 and 10080."
msgstr "Bağışçının ödemeyi göndermek için ne kadar süresi olduğu. 15 ile 10080 arasında."

msgid "API URL"
msgstr "API adresi"

msgid "Leave as is unless Coino Live support tells you otherwise."
msgstr "Coino Live destek ekibi aksini söylemedikçe değiştirmeyin."

msgid "Add your API key below and save."
msgstr "API anahtarınızı aşağıya ekleyip kaydedin."

msgid "The API URL must start with https://."
msgstr "API adresi https:// ile başlamalıdır."

msgid "Connected, but Coino Live cannot price payments in %s yet."
msgstr "Bağlandı, ancak Coino Live henüz %s ile ödeme alamıyor."

msgid "Connected to Coino Live."
msgstr "Coino Live'a bağlanıldı."

msgid "Webhook URL (sent with every payment, nothing to configure):"
msgstr "Webhook adresi (her ödemeyle gönderilir, ayar gerekmez):"

msgid "Coino Live refused the API key: %s"
msgstr "Coino Live API anahtarını reddetti: %s"

msgid "Coino Live Crypto Donations for GiveWP"
msgstr "GiveWP için Coino Live Kripto Bağışları"

msgid "Accept donations in USDT, Bitcoin, Ethereum, TRON, TON, Solana and more with GiveWP. Donors pay on the Coino Live checkout; donations update automatically."
msgstr "GiveWP ile USDT, Bitcoin, Ethereum, TRON, TON, Solana ve daha fazlasıyla bağış kabul edin. Bağışçılar Coino Live ödeme sayfasında öder; bağışlar otomatik güncellenir."


msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: fa_IR\n"
"X-Domain: coinolive-give\n"

msgid "Coino Live Crypto Donations needs GiveWP 3 or newer to be installed and active."
msgstr "افزونه کمک مالی رمزارزی Coino Live به GiveWP نسخه ۳ یا جدیدتر نصب‌شده و فعال نیاز دارد."

msgid "Settings"
msgstr "تنظیمات"

msgid "Dashboard"
msgstr "داشبورد"

msgid "Every five minutes"
msgstr "هر پنج دقیقه"

msgid "Coino Live"
msgstr "Coino Live"

msgid "Sorry, you are not allowed to access this page."
msgstr "شما اجازه دسترسی به این صفحه را ندارید."

msgid "Open Coino Live dashboard"
msgstr "باز کردن داشبورد Coino Live"

msgid "Add your Coino Live API key to see your balance and payments here."
msgstr "برای دیدن موجودی و پرداخت‌ها، کلید API را در تنظیمات وارد کنید."

msgid "Balance"
msgstr "موجودی"

msgid "Total"
msgstr "مجموع"

msgid "Withdraw"
msgstr "برداشت"

msgid "Your whole Coino Live account (all gateways), after fees. Withdraw from the Coino Live dashboard."
msgstr "موجودی کل حساب Coino Live شما (همه درگاه‌ها)، پس از کسر کارمزد. برداشت از داشبورد Coino Live انجام می‌شود."

msgid "No balance yet. Paid donations are added here after fees."
msgstr "هنوز موجودی ندارید. مبلغ کمک‌های پرداخت‌شده پس از کسر کارمزد اینجا اضافه می‌شود."

msgid "Payments"
msgstr "پرداخت‌ها"

msgid "All"
msgstr "همه"

msgid "Donation number"
msgstr "شماره کمک"

msgid "Search"
msgstr "جستجو"

msgid "Date"
msgstr "تاریخ"

msgid "Order"
msgstr "سفارش"

msgid "Status"
msgstr "وضعیت"

msgid "Amount"
msgstr "مبلغ"

msgid "Received"
msgstr "دریافت‌شده"

msgid "Transactions"
msgstr "تراکنش‌ها"

msgid "No payments found."
msgstr "پرداختی پیدا نشد."

msgid "Newer"
msgstr "جدیدتر"

msgid "Older"
msgstr "قدیمی‌تر"

msgid "%s USD missing"
msgstr "%s دلار کسری"

msgid "Payment page"
msgstr "صفحه پرداخت"

msgid "Paid"
msgstr "پرداخت‌شده"

msgid "Partially paid"
msgstr "پرداخت ناقص"

msgid "Confirming"
msgstr "در حال تأیید"

msgid "Waiting for payment"
msgstr "در انتظار پرداخت"

msgid "Expired"
msgstr "منقضی‌شده"

msgid "Cancelled"
msgstr "لغوشده"

msgid "Could not load from Coino Live: %s"
msgstr "بارگیری از Coino Live ممکن نشد: %s"

msgid "The Coino Live API key is not set."
msgstr "کلید API برای Coino Live تنظیم نشده است."

msgid "Could not reach Coino Live: %s"
msgstr "اتصال به Coino Live ممکن نشد: %s"

msgid "There is no Coino Live API at %1$s (HTTP %2$d). Check the API URL setting."
msgstr "در نشانی %1$s هیچ API از Coino Live وجود ندارد (HTTP %2$d). تنظیم «نشانی API» را بررسی کنید."

msgid "Unexpected answer from Coino Live."
msgstr "پاسخ نامعتبر از Coino Live."

msgid "Coino Live (crypto)"
msgstr "Coino Live (رمزارز)"

msgid "Donate with crypto"
msgstr "کمک با رمزارز"

msgid "Donate with USDT, Bitcoin, Ethereum, TRON, TON, Solana and more. You will be taken to a secure payment page."
msgstr "کمک با تتر، بیت‌کوین، اتریوم، ترون، تون، سولانا و ارزهای دیگر. به صفحه پرداخت امن منتقل می‌شوید."

msgid "Crypto donations are not set up yet. Please choose another payment method."
msgstr "کمک رمزارزی هنوز راه‌اندازی نشده است. لطفاً روش پرداخت دیگری انتخاب کنید."

msgid "Crypto donations are not available right now: %s"
msgstr "کمک رمزارزی در حال حاضر در دسترس نیست: %s"

msgid "Crypto donations are refunded from the Coino Live dashboard."
msgstr "بازپرداخت کمک‌های رمزارزی از داشبورد Coino Live انجام می‌شود."

msgid "Donation #%1$s to %2$s"
msgstr "کمک #%1$s به %2$s"

msgid "Coino Live returned a payment that does not belong to this donation. Please try again."
msgstr "Coino Live پرداختی برگرداند که مربوط به این کمک نیست. لطفاً دوباره تلاش کنید."

msgid "Coino Live payment %1$s created (%2$s USD). Waiting for the donor to pay."
msgstr "پرداخت Coino Live با شناسه %1$s ساخته شد (%2$s دلار). در انتظار پرداخت کمک‌کننده."

msgid "Another Coino Live payment (%1$s) was paid for this donation: %2$s."
msgstr "پرداخت دیگری از Coino Live (%1$s) برای این کمک انجام شد: %2$s."

msgid "Coino Live payment is paid but was for %1$s, the donation is %2$s. Please check."
msgstr "پرداخت Coino Live انجام شده اما مبلغ آن %1$s بوده و مبلغ کمک %2$s است. لطفاً بررسی کنید."

msgid "Coino Live payment %1$s confirmed: %2$s"
msgstr "پرداخت Coino Live با شناسه %1$s تأیید شد: %2$s"

msgid "Coino Live: the payment was sent and is waiting for network confirmations."
msgstr "Coino Live: پرداخت ارسال شده و در انتظار تأیید شبکه است."

msgid "Coino Live: only %1$s of %2$s USD received so far. The donor was asked to send the rest."
msgstr "Coino Live: تاکنون فقط %1$s از %2$s دلار دریافت شده است. از کمک‌کننده خواسته شد باقی‌مانده را ارسال کند."

msgid "Coino Live: the payment closed with %1$s of %2$s USD received (in your Coino Live balance)."
msgstr "Coino Live: مهلت پرداخت با دریافت %1$s از %2$s دلار به پایان رسید (این مبلغ در موجودی Coino Live شماست)."

msgid "Coino Live: the payment window closed without payment."
msgstr "Coino Live: مهلت پرداخت بدون دریافت وجه به پایان رسید."

msgid "API key"
msgstr "کلید API"

msgid "Create one in your Coino Live dashboard under Developers. Keys start with ck_live_ (or ck_test_ on the test network)."
msgstr "از بخش توسعه‌دهندگان در داشبورد Coino Live یک کلید بسازید. کلیدها با ck_live_ (یا در شبکه آزمایشی با ck_test_) شروع می‌شوند."

msgid "Webhook signing secret (optional)"
msgstr "کلید امضای وب‌هوک (اختیاری)"

msgid "From your gateway settings (whsec_…). When set, webhooks with a wrong signature are refused. Donations are always checked against the API before they change, so this is an extra layer."
msgstr "از تنظیمات درگاه (whsec_…). اگر وارد شود، وب‌هوک‌هایی با امضای نادرست رد می‌شوند. وضعیت کمک‌ها همیشه پیش از تغییر از API بررسی می‌شود، پس این یک لایه امنیتی اضافه است."

msgid "Payment window (minutes)"
msgstr "مهلت پرداخت (دقیقه)"

msgid "How long the donor has to send the payment. Between 15 and 10080."
msgstr "مدت زمانی که کمک‌کننده برای ارسال پرداخت دارد. بین ۱۵ تا ۱۰۰۸۰."

msgid "API URL"
msgstr "نشانی API"

msgid "Leave as is unless Coino Live support tells you otherwise."
msgstr "تغییر ندهید، مگر اینکه پشتیبانی Coino Live بگوید."

msgid "Add your API key below and save."
msgstr "کلید API را در زیر وارد و ذخیره کنید."

msgid "The API URL must start with https://."
msgstr "نشانی API باید با https:// شروع شود."

msgid "Connected, but Coino Live cannot price payments in %s yet."
msgstr "اتصال برقرار شد، اما Coino Live هنوز پرداخت با واحد %s را پشتیبانی نمی‌کند."

msgid "Connected to Coino Live."
msgstr "اتصال به Coino Live برقرار شد."

msgid "Webhook URL (sent with every payment, nothing to configure):"
msgstr "نشانی وب‌هوک (با هر پرداخت ارسال می‌شود و نیازی به تنظیم ندارد):"

msgid "Coino Live refused the API key: %s"
msgstr "Coino Live کلید API را نپذیرفت: %s"

msgid "Coino Live Crypto Donations for GiveWP"
msgstr "کمک مالی رمزارزی Coino Live برای GiveWP"

msgid "Accept donations in USDT, Bitcoin, Ethereum, TRON, TON, Solana and more with GiveWP. Donors pay on the Coino Live checkout; donations update automatically."
msgstr "دریافت کمک مالی با تتر، بیت‌کوین، اتریوم، ترون، تون، سولانا و ارزهای دیگر در GiveWP. کمک‌کنندگان در صفحه پرداخت Coino Live پرداخت می‌کنند و کمک‌ها خودکار به‌روز می‌شوند."

